# Copier en `.env` (ignoré par git) avant `docker compose up`.

# Clé HMAC de signature des JWT. jjwt fait Keys.hmacShaKeyFor(secret.getBytes())
# donc il faut au moins 32 caractères pour HS256.
JWT_SECRET=dev-only-change-me-strife-jwt-secret-32chars-minimum

# OAuth2 Google (console.cloud.google.com). Laisser les valeurs bidon si tu ne
# testes pas le login social : le service démarre quand même.
GOOGLE_CLIENT_ID=dummy-client-id
GOOGLE_CLIENT_SECRET=dummy-client-secret
