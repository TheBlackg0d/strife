<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.strife</groupId>
    <artifactId>strife-parent</artifactId>
    <version>latest</version>
    <packaging>pom</packaging>
    <name>strife-parent</name>
    <description>Parent POM for the Strife microservices — see doc/architecture/services-overview.md</description>

    <!--
        Ce POM parent centralise la version de Java, la version de Spring Boot,
        et le plugin de build. Chaque module (auth-service, users-service, ...)
        hérite de ce parent plutôt que de spring-boot-starter-parent directement,
        pour qu'on ait un seul endroit où bumper les versions.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- À vérifier/bumper régulièrement : https://spring.io/projects/spring-boot#learn -->
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>26</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>
    <dependencyManagement>
         <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <!--
        Le plugin spring-boot-maven-plugin est déclaré ici pour que TOUS les modules
        en héritent : c'est lui qui "repackage" le jar en fat jar exécutable
        (java -jar app.jar). Sans lui, target/*.jar n'a pas de manifest Main-Class
        et l'image Docker démarre sur "no main manifest attribute".
        Sur ce POM (packaging=pom) le goal repackage est automatiquement ignoré.
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>auth-service</module>
        <module>users-service</module>
        <module>guild-service</module>
        <module>messaging-service</module>
        <module>realtime-gateway</module>
        <module>api-gateway</module>
        <module>event-store-service</module>
    </modules>

</project>
