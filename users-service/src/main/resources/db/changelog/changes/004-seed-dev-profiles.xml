    <!-- Rattache les profils deja presents (ton propre compte) a une poignee
         de comptes seedes, sinon le dashboard reste vide quand on se connecte
         avec son vrai compte plutot qu'avec dev@strife.test. Ne fait rien si
         la base ne contient que les profils seedes. -->
    <changeSet id="006-seed-link-existing-profiles" author="Moncles Junior Herisse" context="seed">
        <sql>
            INSERT INTO relationship (id, first_friend_id, second_friend_id, status, status_initiator, version)
            SELECT gen_random_uuid(),
                   LEAST(existing.user_id, seeded.user_id),
                   GREATEST(existing.user_id, seeded.user_id),
                   seeded.status,
                   CASE WHEN seeded.status = 'PENDING' THEN seeded.user_id ELSE existing.user_id END,
                   1
            FROM profile existing
            CROSS JOIN (
                SELECT user_id,
                       CASE WHEN row_number() OVER (ORDER BY username) &lt;= 6 THEN 'ACCEPTED' ELSE 'PENDING' END AS status
                FROM profile
                WHERE user_id IN (
            'e6cd52d9-3043-4d1d-bc14-8a7233097919',
            'ac6db61b-746a-4bd5-8bbf-050783632a71',
            'd3037129-c9a7-44ee-8486-70698fe98d52',
