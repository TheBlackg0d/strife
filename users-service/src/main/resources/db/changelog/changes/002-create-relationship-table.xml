<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-create-relationship-table" author="Moncles Junior Herisse">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="relationship"/>
            </not>
        </preConditions>

        <createTable tableName="relationship">
            <column name="id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_relationship" nullable="false"/>
            </column>
            <!-- Ordre canonique : first < second, pour qu'une paire (A,B) ne
                 puisse pas exister aussi en (B,A). -->
            <column name="first_friend_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="second_friend_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <!-- Qui a causé le statut actuel : demandeur si PENDING,
                 bloqueur si BLOCKED (seul lui peut le lever). -->
            <column name="status_initiator" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="relationship"
                columnNames="first_friend_id, second_friend_id"
                constraintName="relationship_unique"/>

        <addForeignKeyConstraint
                baseTableName="relationship"
                baseColumnNames="first_friend_id"
                constraintName="fk_relationship_first_friend"
                referencedTableName="profile"
                referencedColumnNames="user_id"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="relationship"
                baseColumnNames="second_friend_id"
                constraintName="fk_relationship_second_friend"
                referencedTableName="profile"
                referencedColumnNames="user_id"
                onDelete="CASCADE"/>

        <!-- Une relation se lit dans les deux sens : un index par colonne. -->
        <createIndex tableName="relationship" indexName="idx_relationship_first_friend_id">
            <column name="first_friend_id"/>
        </createIndex>

        <createIndex tableName="relationship" indexName="idx_relationship_second_friend_id">
            <column name="second_friend_id"/>
        </createIndex>

        <!-- Garde-fou de l'ordre canonique : sans ça, l'unicité composite
             ci-dessus laisserait passer un doublon inversé. -->
        <sql>
            ALTER TABLE relationship
            ADD CONSTRAINT ck_relationship_canonical_order
            CHECK (first_friend_id &lt; second_friend_id)
        </sql>
        <rollback>
            <sql>ALTER TABLE relationship DROP CONSTRAINT ck_relationship_canonical_order</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
