<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-channels-table" author="Moncles Junior Herisse">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="channels"/>
            </not>
        </preConditions>

        <createTable tableName="channels">
            <column name="id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_channels" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="1"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
