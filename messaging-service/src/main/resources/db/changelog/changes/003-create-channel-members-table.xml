<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-create-channel-members-table" author="Moncles Junior Herisse">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="channel_members"/>
            </not>
        </preConditions>

        <createTable tableName="channel_members">
            <column name="channel_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
                tableName="channel_members"
                columnNames="channel_id, user_id"
                constraintName="pk_channel_members"/>

        <addForeignKeyConstraint
                baseTableName="channel_members"
                baseColumnNames="channel_id"
                constraintName="fk_channel_members_channel"
                referencedTableName="channels"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="channel_members"
                baseColumnNames="user_id"
                constraintName="fk_channel_members_user"
                referencedTableName="users"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <createIndex tableName="channel_members" indexName="idx_channel_members_user">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
