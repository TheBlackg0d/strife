<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-create-members-table" author="Moncles Junior Herisse">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="members"/>
            </not>
        </preConditions>

        <createTable tableName="members">
            <column name="id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_members" nullable="false"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(255)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="1"/>
        </createTable>
        <addUniqueConstraint
                tableName="members"
                columnNames="user_id"
                constraintName="member_user_unique"/>
    </changeSet>

</databaseChangeLog>
