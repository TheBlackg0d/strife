<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-create-channel-table" author="Moncles Junior Herisse">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="channel"/>
            </not>
        </preConditions>

        <createTable tableName="channel">
            <column name="id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_channel" nullable="false"/>
            </column>
            <column name="guild_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="channel_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="channel"
                baseColumnNames="guild_id"
                constraintName="fk_channel_guild"
                referencedTableName="guild"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <createIndex tableName="channel" indexName="idx_channel_guild_id">
            <column name="guild_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
