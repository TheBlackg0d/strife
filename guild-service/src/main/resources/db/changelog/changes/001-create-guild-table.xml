<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-guild-table" author="Moncles Junior Herisse">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="guild"/>
            </not>
        </preConditions>

        <createTable tableName="guild">
            <column name="id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_guild" nullable="false"/>
            </column>
            <column name="owner_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="guild_picture" type="VARCHAR(255)"/>
        </createTable>

        <createIndex tableName="guild" indexName="idx_guild_owner_id">
            <column name="owner_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
